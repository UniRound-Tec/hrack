{
  "name": "vibing",
  "version": "0.2.5",
  "description": "AI CLI 专用终端",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "predev": "npm run subset-fonts",
    "dev": "electron-vite dev",
    "subset-fonts": "node scripts/subset-fonts.mjs",
    "assert-font-size": "node scripts/assert-font-size.mjs",
    "build": "npm run subset-fonts && electron-vite build && npm run assert-font-size",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "postinstall": "electron-rebuild -f -w node-pty",
    "build:win": "npm run release:win",
    "build:mac": "npm run release:mac",
    "release:win": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/release-win.ps1",
    "release:github:win": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/release-github-win.ps1",
    "release:mac": "bash scripts/release-mac.sh",
    "release:github:mac": "bash scripts/release-github-mac.sh",
    "e2e": "npm run build && playwright test",
    "e2e:only": "playwright test"
  },
  "author": "",
  "license": "Apache-2.0",
  "build": {
    "appId": "com.vibing.app",
    "productName": "Vibing",
    "artifactName": "Vibing-Setup-${version}.${ext}",
    "afterPack": "scripts/assert-packaged-resources.cjs",
    "files": [
      "**/*",
      "!resources/tray{,/**/*}",
      "!dsh-runtime{,/**/*}",
      "!artifacts{,/**/*}",
      "!release{,/**/*}",
      "!test-results{,/**/*}",
      "!playwright-report{,/**/*}"
    ],
    "extraResources": [
      {
        "from": "resources/tray",
        "to": "tray",
        "filter": [
          "*.png"
        ]
      },
      {
        "from": "dsh-runtime",
        "to": "dsh-runtime",
        "filter": [
          "package.json",
          "package-lock.json",
          "node_modules/**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/tray/vibing-master.png"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "artifactName": "Vibing-${version}-macos-${arch}.${ext}"
    },
    "dmg": {
      "title": "Vibing ${version}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Vibing"
    }
  },
  "dependencies": {
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@lezer/highlight": "^1.2.3",
    "@lobehub/icons": "^5.15.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "0.20.0-beta.291",
    "@xterm/xterm": "6.1.0-beta.292",
    "gsap": "^3.15.0",
    "lucide-react": "^1.28.0",
    "motion": "^12.43.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "pngjs": "^7.0.0",
    "subset-font": "^2.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  }
}
